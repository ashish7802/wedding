{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "open",
          "value": "1"
        }
      ],
      "destination": "/open.html"
    },
    {
      "source": "/i/drshubhanil-drnidhi-love",
      "has": [
        {
          "type": "query",
          "key": "open",
          "value": "1"
        }
      ],
      "destination": "/open.html"
    },
    {
      "source": "/open",
      "destination": "/open.html"
    },
    {
      "source": "/i/drshubhanil-drnidhi-love",
      "destination": "/index.html"
    },
    {
      "source": "/api/rsvp/:id",
      "destination": "/api/rsvps?id=:id"
    },
    {
      "source": "/api/rsvp",
      "destination": "/api/rsvps"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://chungdoi.com/_next/:path*"
    },
    {
      "source": "/fonts/:path*",
      "destination": "https://chungdoi.com/fonts/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://chungdoi.com/images/:path*"
    },
    {
      "source": "/backend-api/:path*",
      "destination": "https://chungdoi.com/backend-api/:path*"
    }
  ]
}

