{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, OPTIONS" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "open",
          "value": "1"
        }
      ],
      "destination": "/open.html"
    },
    {
      "source": "/i/drshubhanil-drnidhi-love",
      "has": [
        {
          "type": "query",
          "key": "open",
          "value": "1"
        }
      ],
      "destination": "/open.html"
    },
    {
      "source": "/open",
      "destination": "/open.html"
    },
    {
      "source": "/i/drshubhanil-drnidhi-love",
      "destination": "/index.html"
    },
    {
      "source": "/api/rsvp/:id",
      "destination": "/api/rsvps?id=:id"
    },
    {
      "source": "/api/rsvp",
      "destination": "/api/rsvps"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://chungdoi.com/_next/:path*"
    },
    {
      "source": "/fonts/:path*",
      "destination": "https://chungdoi.com/fonts/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "https://chungdoi.com/images/:path*"
    },
    {
      "source": "/backend-api/:path*",
      "destination": "https://chungdoi.com/backend-api/:path*"
    }
  ]
}

